# ============================================================
# Optional AI Fallback Configuration (ai_verifier.py)
# ============================================================
# NOTE: The core voice engine works 100% offline without any API key!
# An API key is ONLY needed for optional LLM fallback on ambiguous commands.
#
# To configure:
#   Option A (Recommended): Open Settings (⚙) inside the app.
#   Option B (Developers): Copy this file to ".env" and fill in your own key.
#
# NEVER commit your real .env file to GitHub!

# Free Groq API key: https://console.groq.com -> API Keys -> Create Key
# Or OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-api-key-here

# OpenAI-compatible endpoint (leave empty for official OpenAI API)
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Model name (e.g., qwen/qwen3-32b or llama-3.3-70b-versatile on Groq, or gpt-4o-mini on OpenAI)
OPENAI_MODEL=qwen/qwen3-32b
